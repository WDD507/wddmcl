<window name="more_page">
  <!-- 标题和导航 -->
  <label name="Title" x="10" y="10" w="280" h="30" style:normal:text_color="#3F3F3F" style:normal:font_size="30" style:normal:font_name="" text="WDD's Minecraft Launcher"/>
  <button name="home_page_btn" x="290" y="10" w="100" h="36" style="WDDdefault" text="主页"/>
  <button name="download_page_btn" x="400" y="10" w="100" h="36" style="WDDdefault" text="下载"/>
  <button name="settings_page_btn" x="510" y="10" w="100" h="36" style="WDDdefault" text="设置"/>
  <button name="more_page_btn" x="620" y="10" w="100" h="36" enable="false" style="WDDdefault" text="更多"/>
  <!-- 账户管理 -->
  <view name="account_card" x="10" y="55" w="780" h="220" style:normal:bg_color="#F5F5F5">
    <label name="account_title" x="15" y="15" w="100" h="25" style:normal:font_size="18" style:normal:text_color="#333333" text="账户管理"/>
    <button name="add_account_btn" x="15" y="50" w="120" h="36" style="WDDdefault" text="添加账户"/>
    <button name="delete_account_btn" x="145" y="50" w="120" h="36" style="WDDdefault" text="删除账户"/>
    <button name="switch_account_btn" x="275" y="50" w="120" h="36" style="WDDdefault" text="切换账户"/>
    <!-- 账户列表 -->
    <scroll_view name="account_scroll" x="15" y="95" w="750" h="110">
      <list_view name="account_list" x="0" y="0" w="750" h="110">
        <list_item name="acc_item_1" x="0" y="0" w="750" h="45">
          <label name="acc_name_1" x="15" y="15" w="150" h="20" style:normal:font_size="16" text="Player1"/>
          <label name="acc_type_1" x="170" y="15" w="100" h="20" style:normal:font_size="14" text="离线账户"/>
          <check_button name="acc_active_1" x="720" y="12" w="20" h="20" value="true"/>
        </list_item>
        <list_item name="acc_item_2" x="0" y="45" w="750" h="45">
          <label name="acc_name_2" x="15" y="15" w="150" h="20" style:normal:font_size="16" text="MicrosoftUser"/>
          <label name="acc_type_2" x="170" y="15" w="100" h="20" style:normal:font_size="14" text="微软账户"/>
          <check_button name="acc_active_2" x="720" y="12" w="20" h="20" value="false"/>
        </list_item>
      </list_view>
    </scroll_view>
  </view>
  <!-- 关于 -->
  <view name="about_card" x="10" y="290" w="780" h="180" style:normal:bg_color="#F5F5F5">
    <label name="about_title" x="15" y="15" w="100" h="25" style:normal:font_size="18" style:normal:text_color="#333333" text="关于"/>
    <label name="version_info" x="15" y="55" w="300" h="20" style:normal:font_size="14" text="版本：0.0.5.1"/>
    <label name="author_info" x="15" y="80" w="300" h="20" style:normal:font_size="14" text="作者：WDDWXY"/>
    <label name="description" x="15" y="105" w="750" h="40" style:normal:font_size="14" text="WDD's Minecraft Launcher - 一个基于 AWTK 的开源 Minecraft 启动器"/>
    <button name="check_update_btn" x="15" y="150" w="120" h="25" style="WDDdefault" text="检查更新"/>
    <button name="github_btn" x="145" y="150" w="120" h="25" style="WDDdefault" text="GitHub"/>
  </view>
</window>